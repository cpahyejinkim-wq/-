# Runtime mode. "mock" uses synthetic data (Phase 1). "live" uses real providers (Phase 2).
APP_MODE=mock

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS origins the FastAPI app will accept. Comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5500,file://

# --- Phase 2: real provider credentials ---
# OpenDART API key (https://opendart.fss.or.kr). Used by OpenDartReader for 재무제표.
OPENDART_API_KEY=
# 한국은행 ECOS API key (https://ecos.bok.or.kr/api). Used by macro context in risk engine.
ECOS_API_KEY=
# Optional path for OHLCV disk cache (per-day parquet). Created on first use.
CACHE_DIR=.cache/ohlcv
